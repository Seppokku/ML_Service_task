DATA_PATH=data/raw/team_activity.csv
PROCESSED_DIR=data/processed
REGISTRY_PATH=model_registry
MODEL_VERSION=latest
INFERENCE_RELOAD_URL=http://inference:8000/reload

METRICS_MIN_PR_AUC=0.3
METRICS_MIN_RECALL=0.05
RECALL_PRECISION_THRESHOLD=0.6

TRAIN_RATIO=0.7
VALID_RATIO=0.2
TEST_RATIO=0.1

RANDOM_SEED=42
GENERATE_DATA_IF_MISSING=true
SYNTHETIC_ROWS=500
LOG_LEVEL=INFO
CB_TUNING_TRIALS=6
CB_EARLY_STOPPING_ROUNDS=50

LABEL_POS_RATE=0.18
LABEL_NOISE_STD=0.12
LABEL_SHARPNESS=2.0
LABEL_SIGNAL_SCALE=1.15
